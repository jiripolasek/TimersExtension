---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  crop: [left: number, top: number, width: number, height: number];
  eager?: boolean;
}

const { src, alt, crop: [left, top, width, height], eager = false } = Astro.props;
---

<div class="screenshot" style={`--left:${-left}px;--top:${-top}px;--width:${width}px;--height:${height}px`}>
  <Image src={src} alt={alt} width={src.width} format="webp" quality={95} loading={eager ? "eager" : "lazy"} />
</div>

<style>
  .screenshot {
    width: var(--width);
    max-width: 100%;
    height: var(--height);
    overflow: hidden;
    border-radius: 0.65rem;
    background: #162432;
  }

  img {
    max-width: none;
    transform: translate(var(--left), var(--top));
  }
</style>
