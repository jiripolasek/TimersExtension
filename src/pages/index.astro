---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Screenshot from "../components/Screenshot.astro";
import { site, withBase } from "../data/site";
import timerScreenshot from "../assets/01-timers.png";
import wallpaper from "../assets/wallpaper.jpg";
import dockScreenshot from "../assets/05-timers-and-dock-wide.png";

const heroBackground = await getImage({ src: wallpaper, width: 1440, format: "webp", quality: 86 });
---

<Layout>
  <section class="hero" style={`--hero-wallpaper: url("${heroBackground.src}")`}>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="kicker">PowerToys Command Palette</p>
        <h1>Timers and <span>stopwatches</span></h1>
        <p>Start a countdown or record a lap in Command Palette. See your timers and stopwatches on the Dock while you work.</p>
        <div class="button-row">
          <a class="button button-primary" href="#install">Installation</a>
          <a class="button button-hero" href={withBase("preview/")}>See screenshots</a>
        </div>
      </div>
      <div class="hero-previews">
        <a class="hero-preview" href={withBase("preview/#dock")} aria-label="See the Dock screenshot">
          <span class="preview-label">Dock</span>
          <Screenshot src={dockScreenshot} crop={[799, 0, 322, 38]} alt="The Dock showing Open timer list, a running Focus timer, and a running Rehearsal stopwatch." eager />
        </a>
        <a class="hero-preview" href={withBase("preview/#timers")} aria-label="See the Command Palette screenshot">
          <span class="preview-label">Command Palette</span>
          <Screenshot src={timerScreenshot} crop={[596, 306, 728, 302]} alt="The Timers list showing Focus running, Eggs paused, and Coffee finished." eager />
        </a>
      </div>
    </div>
  </section>

  <section class="wrap section features" id="features" aria-labelledby="features-heading">
    <div class="section-heading">
      <h2 id="features-heading">From a quick countdown to a full session.</h2>
      <p>Run several timers and stopwatches at once. Each can pause, resume, or finish independently.</p>
    </div>
    <div class="feature-grid">
      <article class="feature">
        <Icon name="keyboard" size={24} />
        <h3>Start from the keyboard</h3>
        <p>Type <code>Focus 25m</code> or <code>until 15:30</code> in Command Palette. Preview the finish time before you press Enter.</p>
      </article>
      <article class="feature">
        <Icon name="timer" size={24} />
        <h3>Keep your usual timers</h3>
        <p>Save a countdown as a template, pin it to the Dock, or repeat your last timer. Pick a sound or get a silent notification.</p>
      </article>
      <article class="feature">
        <Icon name="stopwatch" size={24} />
        <h3>Record and compare laps</h3>
        <p>Track each lap and total elapsed time. Compare the fastest and slowest splits, then copy the final elapsed time.</p>
      </article>
    </div>
  </section>

  <section class="dock-section" aria-labelledby="dock-heading">
    <div class="wrap section dock-inner">
      <div class="dock-copy">
        <Icon name="dock" size={27} />
        <h2 id="dock-heading">Keep time in sight.</h2>
        <p>Pin one timer or stopwatch, or add a Dock band to follow all your running and paused items. The name and time stay visible in Compact mode.</p>
        <a class="text-link" href={site.dockGuide}>Set up the Command Palette Dock</a>
      </div>
      <dl class="dock-options">
        <div>
          <dt>Active timers and stopwatches</dt>
          <dd>See every running or paused item in its own Dock button.</dd>
        </div>
        <div>
          <dt>Latest active item</dt>
          <dd>Follow the most recent running or paused timer or stopwatch.</dd>
        </div>
        <div>
          <dt>Saved templates</dt>
          <dd>Pin a template to start the same countdown again with one click.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="wrap section install" id="install" aria-labelledby="install-heading">
    <div class="section-heading">
      <h2 id="install-heading">Install Timers</h2>
      <p>Requires <a href={site.powerToys}>Microsoft PowerToys</a> with Command Palette enabled.</p>
    </div>
    <p class="availability">The first public release is planned for Microsoft Store and WinGet. You can build Timers from source today.</p>
    <div class="install-grid">
      <article class="install-option">
        <Icon name="store" />
        <h3>Microsoft Store</h3>
        <p>Once released, search for <strong>Timers for Command Palette</strong> in the Microsoft Store.</p>
      </article>
      <article class="install-option">
        <Icon name="terminal" size={24} />
        <h3>WinGet</h3>
        <p>Use the package ID after the public release.</p>
        <code class="install-command">{site.winget}</code>
      </article>
      <article class="install-option">
        <Icon name="branch" />
        <h3>GitHub</h3>
        <p>Browse the source or check for signed x64 and ARM64 packages.</p>
        <div class="install-links">
          <a href={site.repository}>Source code</a>
          <a href={site.releases}>Releases</a>
        </div>
      </article>
    </div>
  </section>
</Layout>
