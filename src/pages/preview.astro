---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import timers from "../assets/01-timers.png";
import newTimer from "../assets/02-new-timer.png";
import stopwatches from "../assets/03-stopwatches.png";
import laps from "../assets/04-stopwatch-laps.png";
import dock from "../assets/05-timers-and-dock-wide.png";
import home from "../assets/06-home-commands.png";
import templates from "../assets/07-home-template-commands.png";

const screenshots = [
  { id: "dock", title: "Timers in the Dock", image: dock, alt: "The Timers list and a Dock with shortcuts for the list, a running timer, and a running stopwatch." },
  { id: "timers", title: "Timers and saved templates", image: timers, alt: "Focus is running, Eggs is paused, and Coffee is finished. Three templates appear below the timer list." },
  { id: "new-timer", title: "Create a countdown", image: newTimer, alt: "The New timer form in Command Palette." },
  { id: "stopwatches", title: "Stopwatches", image: stopwatches, alt: "The Stopwatches list in Command Palette with running and finished entries." },
  { id: "laps", title: "Stopwatch laps", image: laps, alt: "A stopwatch detail page with lap and elapsed times." },
  { id: "home", title: "Commands on Home", image: home, alt: "Command Palette Home with Timers, Stopwatches, saved template shortcuts, and recent timer actions." },
  { id: "templates", title: "Find a saved timer by name", image: templates, alt: "Command Palette search results showing matching timer template commands." },
];
---

<Layout title="Screenshots | Timers for Command Palette" path="preview/">
  <section class="wrap document" aria-labelledby="screenshots-heading">
    <h1 id="screenshots-heading">Screenshots</h1>
    <p class="document-intro">A closer look at countdowns, stopwatch laps, and the Command Palette Dock.</p>
    <div class="gallery">
      {screenshots.map(({ id, title, image, alt }) => (
        <figure id={id} class:list={{ "gallery-wide": id === "dock" }}>
          <a href={image.src} aria-label={`Open full-size screenshot of ${title.toLowerCase()}`}>
            <Image src={image} alt={alt} width={id === "dock" ? 1440 : 960} format="webp" quality={88} loading={id === "dock" ? "eager" : "lazy"} />
          </a>
          <figcaption>{title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Layout>
